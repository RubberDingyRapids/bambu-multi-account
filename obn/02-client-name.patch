From 5d9e4fd6eed73e60d4e69905cef417232ae3a235 Mon Sep 17 00:00:00 2001
From: RubberDingyRapids <53348682+RubberDingyRapids@users.noreply.github.com>
Date: Mon, 12 Oct 2026 08:54:30 +0100
Subject: [PATCH] config: treat the old client_name default as BambuStudio

obn.conf files created before 8e3dfb2 still contain client_name = OpenBambooNetworking, because the template is only used when the file is missing. With that value /user/ttcode answers 403 {"code":8}, so H2S live view fails with "Connection Failed". This maps the old default to BambuStudio when the config is read, so existing installs work without editing the file. Anyone who set a different name on purpose is unaffected.
---
 src/config.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/config.cpp b/src/config.cpp
index 88ea6a7..c63a532 100644
--- a/src/config.cpp
+++ b/src/config.cpp
@@ -125,7 +125,7 @@ void apply_key(Settings& out, const std::string& key, const std::string& val)
     else if (key == "slicer_key_pem")               out.slicer_key_pem = val;
     else if (key == "slicer_cert_pem")             out.slicer_cert_pem = val;
     else if (key == "slicer_crl_pem")              out.slicer_crl_pem = val;
-    else if (key == "client_name")                 out.client_name = val;
+    else if (key == "client_name")                 out.client_name = (val == "OpenBambooNetworking") ? "BambuStudio" : val;  // pre-8e3dfb2 default: /my/task and /user/ttcode reject it with 403
     else if (key == "executable_info")             out.executable_info = val;
     else if (key == "mytask_pop") {
         // `auto` and an absent key both mean the region-based default
-- 
